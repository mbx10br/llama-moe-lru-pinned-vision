+// Keep two interior anchors and the two newest states in a four-checkpoint pool.
+static size_t server_checkpoint_grid_evict(const std::vector<int64_t> & positions, int64_t n_tokens) {
+    GGML_ASSERT(positions.size() == 5 && n_tokens > 0);
+    size_t evict = 0;
+    int64_t best_cost = INT64_MAX;
+    for (size_t drop = 0; drop < 3; ++drop) {
+        int64_t cost = 0;
+        int64_t target = n_tokens / 3;
+        for (size_t i = 0; i < 3; ++i) {
+            if (i == drop) {
+                continue;
+            }
+            const int64_t delta = positions[i] - target;
+            cost += delta < 0 ? -delta : delta;
+            target = 2 * n_tokens / 3;
+        }
+        if (cost < best_cost) {
+            best_cost = cost;
+            evict = drop;
+        }
+    }
+    return evict;
+}
