+static enum ggml_status ggml_cuda_compute_host_weights_strict(ggml_backend_t backend, ggml_cgraph * graph) {
+    auto * ctx = (ggml_backend_cuda_context *) backend->context;
+    const auto dev = ggml_backend_get_device(backend);
+    const auto cuda_buft = ggml_backend_cuda_buffer_type(ctx->device);
+    CUDA_CHECK(cudaDeviceSynchronize());
+    for (int i = 0; i < graph->n_nodes; ++i) {
+        const ggml_tensor * original = graph->nodes[i];
+        if (ggml_cuda_is_view_or_noop(original) || (original->flags & GGML_TENSOR_FLAG_COMPUTE) == 0) {
+            continue;
+        }
+        if (!original->buffer || original->buffer->buft != cuda_buft) {
+            GGML_LOG_ERROR("%s: destination must be device-local CUDA memory\n", __func__);
+            return GGML_STATUS_FAILED;
+        }
+        ggml_tensor node = *original;
+        std::array<ggml_tensor, GGML_MAX_SRC> sources;
+        ggml_cuda_host_weight_staging owned; // destroyed before local tensor metadata
+        for (int j = 0; j < GGML_MAX_SRC; ++j) {
+            const ggml_tensor * src = original->src[j];
+            if (!src) {
+                continue;
+            }
+            if (!src->buffer) {
+                return GGML_STATUS_FAILED;
+            }
+            if (src->buffer->buft == cuda_buft) {
+                continue;
+            }
+            if (!ggml_backend_buft_is_cuda_host_weights(src->buffer->buft, dev) ||
+                ggml_backend_buffer_get_usage(src->buffer) != GGML_BACKEND_BUFFER_USAGE_WEIGHTS) {
+                GGML_LOG_ERROR("%s: non-device source is not this device's immutable Host_W\n", __func__);
+                return GGML_STATUS_FAILED;
+            }
+            if (original->op == GGML_OP_CPY && j == 1) {
+                GGML_LOG_ERROR("%s: refusing write into immutable Host_W\n", __func__);
+                return GGML_STATUS_FAILED;
+            }
+            // Views retain their full byte span and strides; reject any escaped range.
+            const uintptr_t base = (uintptr_t) ggml_backend_buffer_get_base(src->buffer);
+            const uintptr_t data = (uintptr_t) src->data;
+            const size_t span = ggml_nbytes(src);
+            const size_t capacity = ggml_backend_buffer_get_size(src->buffer);
+            if (data < base || data - base > capacity || span > capacity - (data - base)) {
+                return GGML_STATUS_FAILED;
+            }
+            sources[j] = *src;
+            sources[j].view_src = nullptr;
+            sources[j].view_offs = 0;
+            sources[j].extra = nullptr;
+            const size_t allocation = ggml_backend_buft_get_alloc_size(cuda_buft, &sources[j]);
+            owned.buffers[j] = ggml_backend_buft_alloc_buffer(cuda_buft, allocation);
+            if (!owned.buffers[j]) {
+                return GGML_STATUS_ALLOC_FAILED;
+            }
+            ggml_backend_buffer_set_usage(owned.buffers[j], GGML_BACKEND_BUFFER_USAGE_WEIGHTS);
+            sources[j].buffer = owned.buffers[j];
+            sources[j].data = ggml_backend_buffer_get_base(owned.buffers[j]);
+            if (ggml_backend_buffer_init_tensor(owned.buffers[j], &sources[j]) != GGML_STATUS_SUCCESS) {
+                return GGML_STATUS_FAILED;
+            }
+            // Synchronous transfer also orders initialization/padding before kernels.
+            CUDA_CHECK(cudaMemcpy(sources[j].data, src->data, span, cudaMemcpyHostToDevice));
+            node.src[j] = &sources[j];
+        }
+        if (!ggml_cuda_compute_forward(*ctx, &node)) {
+            GGML_LOG_ERROR("%s: unsupported CUDA op %s (%s); no CPU fallback\n", __func__, original->name, ggml_op_name(original->op));
+            return GGML_STATUS_FAILED;
+        }
+        // 'owned' synchronizes all streams before freeing GPU buffers and local metadata.
+    }
+    return GGML_STATUS_SUCCESS;
+}
