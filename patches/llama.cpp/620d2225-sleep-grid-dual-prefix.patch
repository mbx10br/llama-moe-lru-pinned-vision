+static void test_checkpoint_grid(testing & t) {
+    t.assert_equal("small prompt", (uint8_t) 0, server_checkpoint_grid_anchor(512, 1024, 512));
+    t.assert_equal("before first anchor", (uint8_t) 0, server_checkpoint_grid_anchor(4095, 12288, 512));
+    t.assert_equal("first natural boundary", (uint8_t) 1, server_checkpoint_grid_anchor(4096, 12288, 512));
+    t.assert_equal("unaligned natural boundary", (uint8_t) 1, server_checkpoint_grid_anchor(4200, 12288, 512));
+    t.assert_equal("past first window", (uint8_t) 0, server_checkpoint_grid_anchor(4608, 12288, 512));
+    t.assert_equal("second anchor", (uint8_t) 2, server_checkpoint_grid_anchor(8192, 12288, 512));
+    t.assert_equal("zero batch", (uint8_t) 0, server_checkpoint_grid_anchor(8192, 12288, 0));
+    t.assert_equal("retain two anchors and newest two", (size_t) 2,
+            server_checkpoint_grid_evict({4096, 8192, 11000, 12000, 12100}, 12288));
+    t.assert_equal("discard stale early state", (size_t) 0,
+            server_checkpoint_grid_evict({1024, 4096, 8192, 12000, 12100}, 12288));
+    std::vector<int64_t> positions = {4096, 8192, 12000, 12100};
+    for (int64_t tail = 12110; tail < 12200; tail += 10) {
+        positions.push_back(tail);
+        positions.erase(positions.begin() + server_checkpoint_grid_evict(positions, 12288));
+        t.assert_equal("first interior anchor survives appended turns", (int64_t) 4096, positions[0]);
+        t.assert_equal("second interior anchor survives appended turns", (int64_t) 8192, positions[1]);
+        t.assert_equal("newest state retained", tail, positions.back());
+    }
+}
+
+static void test_prefix_cache_preservation(testing & t) {
+    server_prompt_cache cache(1, 100000);
+    server_prompt longer{server_tokens(llama_tokens{1, 2, 3, 4, 5, 6}, false), {}};
+    server_prompt active{server_tokens(llama_tokens{1, 2, 3, 4}, false), {}};
+    t.assert_true("allocate larger conversation", cache.alloc(longer, 128, 0) != nullptr);
+    t.assert_true("legacy skips contained prompt", cache.alloc(active, 128, 0) == nullptr);
+    t.assert_true("opt-in preserves exact active point", cache.alloc(active, 128, 0, true) != nullptr);
+    t.assert_true("exact entry prevents duplicate", cache.alloc(active, 128, 0, true) == nullptr);
+
+    server_prompt_cache bounded(1, 100000);
+    server_prompt old{server_tokens(llama_tokens{8, 9}, false), {}};
+    server_prompt replacement{server_tokens(llama_tokens{11, 12}, false), {}};
+    t.assert_true("old state allocated", bounded.alloc(old, 200000, 0) != nullptr);
+    t.assert_true("reserved selected RAM candidate respected",
+        bounded.alloc(replacement, 500000, 0, true, 600000) == nullptr);
+    t.assert_equal("failed preservation keeps old RAM", size_t(1), bounded.states.size());
+    t.assert_true("reservation evicts other LRU before copying active",
+        bounded.alloc(replacement, 500000, 0, true, 400000) != nullptr);
+    t.assert_true("resident plus reserved stays bounded", bounded.size() + 400000 <= bounded.limit_size);
+
+    server_task_result_slot_save_load response;
+    response.id_slot = 0; response.filename = "base.bin"; response.is_save = false;
+    response.n_tokens = 123; response.n_bytes = 0; response.t_ms = 0;
+    t.assert_true("legacy response unchanged", !response.to_json().contains("restore_source"));
+    response.restore_source = "active"; response.n_reusable = 100;
+    response.preserve_failed = true; response.restore_reason = "active_preservation_unavailable";
+    t.assert_true("controlled preservation failure", response.to_json().at("preserve_failed").get<bool>());
+    t.assert_equal("active reused count", size_t(100), response.to_json().at("n_reusable").get<size_t>());
+}
