+static uint8_t server_checkpoint_grid_anchor(int64_t start, int64_t n_tokens, int64_t n_batch) {
+    if (n_batch <= 0 || n_tokens < 3 * n_batch || start <= 0) {
+        return 0;
+    }
+    uint8_t anchors = 0;
+    for (int i = 1; i <= 2; ++i) {
+        const int64_t target = i * n_tokens / 3;
+        if (start >= target && start - target < n_batch) {
+            anchors |= 1 << (i - 1);
+        }
+    }
+    return anchors;
+}
 
