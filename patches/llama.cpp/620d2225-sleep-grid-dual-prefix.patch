diff --git a/tests/test-server-prefix-selection.cpp b/tests/test-server-prefix-selection.cpp
new file mode 100644
--- /dev/null
+++ b/tests/test-server-prefix-selection.cpp
@@ -0,0 +1,32 @@
+#include "../tools/server/server-prefix-selection.h"
+#include <cassert>
+#include <iostream>
+
+int main() {
+    // An exact prefix can use the live recurrent state without rewinding it.
+    assert(server_prefix_reusable(16000, 17000, 16000, 15999, 0, {}) == 16000);
+    // A long conversation with matching text is NOT a reusable 16K state if
+    // its recurrent state and only checkpoint are beyond the divergence.
+    assert(server_prefix_reusable(16000, 17000, 16000, 59999, 0,
+        {{20000, 20001, 20000}}) == 0);
+    // The earlier checkpoint is usable, even though the live state is 60K.
+    assert(server_prefix_reusable(16000, 17000, 16000, 59999, 0,
+        {{8000, 8001, 8000}, {20000, 20001, 20000}}) == 8000);
+    // Equal complete prompts must still process a token to recover logits.
+    assert(server_prefix_reusable(16000, 16000, 16000, 15999, 0,
+        {{15800, 15801, 15800}}) == 15800);
+    // Importing a base is not generation: do not reserve a logits token.
+    assert(server_prefix_reusable(16000, 16000, 16000, 15999, 0, {}, false) == 16000);
+    // SWA eligibility follows the native position threshold.
+    assert(server_prefix_reusable(16000, 17000, 16000, 15000, 4096, {}) == 0);
+    assert(server_prefix_better(16000, server_prefix_source::active, 16000, server_prefix_source::disk));
+    assert(server_prefix_better(16000, server_prefix_source::ram, 16000, server_prefix_source::disk));
+    assert(!server_prefix_better(16000, server_prefix_source::ram, 16000, server_prefix_source::active));
+    assert(server_prefix_better(17000, server_prefix_source::disk, 16000, server_prefix_source::active));
+    const auto live_advanced = server_prefix_reusable(50000, 51000, 50000, 49999, 0, {});
+    assert(server_prefix_better(live_advanced, server_prefix_source::active, 16000, server_prefix_source::disk));
+    const auto unusable_ram = server_prefix_reusable(49000, 51000, 49000, 59999, 0,
+        {{50000, 50001, 50000}});
+    assert(server_prefix_better(16000, server_prefix_source::disk, unusable_ram, server_prefix_source::ram));
+    std::cout << "prefix selection invariants passed\n";
+}
diff --git a/tools/server/server-prefix-selection.h b/tools/server/server-prefix-selection.h
new file mode 100644
--- /dev/null
+++ b/tools/server/server-prefix-selection.h
@@ -0,0 +1,44 @@
+#pragma once
+
+#include <algorithm>
+#include <cstddef>
+#include <cstdint>
+#include <vector>
+
+// Pure policy for the opt-in slot restore path. No model, file or cache mutation.
+// Position arithmetic and checkpoint eligibility mirror prompt reuse below
+// TAG_CHECKPOINTS_FIX_POS_MIN in server-context.cpp.
+struct server_prefix_checkpoint_view {
+    int64_t pos_min;
+    int64_t pos_max;
+    size_t reusable_tokens;
+};
+
+inline size_t server_prefix_reusable(
+        size_t lcp, size_t target_tokens, int64_t pos_next, int64_t state_pos_min,
+        int64_t n_swa, const std::vector<server_prefix_checkpoint_view> & checkpoints,
+        bool require_logits = true) {
+    if (lcp == 0 || target_tokens == 0 || state_pos_min < 0) {
+        return 0;
+    }
+    const bool has_new_tokens = lcp < target_tokens || !require_logits;
+    const int64_t pos_eval = pos_next - (has_new_tokens ? 0 : 1);
+    const int64_t threshold = std::max<int64_t>(0, n_swa > 0 ? pos_eval - n_swa + 2 : pos_eval);
+    const size_t cap = std::min(lcp, target_tokens - (require_logits ? 1 : 0));
+    if (state_pos_min < threshold) {
+        return cap;
+    }
+    for (auto it = checkpoints.rbegin(); it != checkpoints.rend(); ++it) {
+        if (it->pos_max <= pos_next && (it->pos_min < threshold || it->pos_min == 0)) {
+            return std::min(cap, it->reusable_tokens);
+        }
+    }
+    return 0;
+}
+
+enum class server_prefix_source { active, ram, disk };
+
+inline bool server_prefix_better(size_t score, server_prefix_source source,
+                                 size_t best_score, server_prefix_source best_source) {
+    return score > best_score || (score == best_score && source < best_source);
+}
