+// Graph-local conservative staging. Original tensor metadata/pointers are immutable.
+static bool ggml_cuda_graph_has_host_weights(ggml_cgraph * graph) {
+    for (int i = 0; i < graph->n_nodes; ++i) {
+        const ggml_tensor * node = graph->nodes[i];
+        if (node->buffer && node->buffer->buft->iface.get_name == ggml_backend_cuda_host_weights_name) {
+            return true;
+        }
+        for (int j = 0; j < GGML_MAX_SRC; ++j) {
+            const ggml_tensor * src = node->src[j];
+            if (src && src->buffer && src->buffer->buft->iface.get_name == ggml_backend_cuda_host_weights_name) {
+                return true;
+            }
+        }
+    }
+    return false;
+}
+
+struct ggml_cuda_host_weight_staging {
+    std::array<ggml_backend_buffer_t, GGML_MAX_SRC> buffers = {};
+    ~ggml_cuda_host_weight_staging() {
+        // Kernels can use internal streams: stream-only synchronization is insufficient.
+        CUDA_CHECK(cudaDeviceSynchronize());
+        for (auto buffer : buffers) {
+            if (buffer) {
+                ggml_backend_buffer_free(buffer);
+            }
+        }
+    }
+};
