+# These are source-level orientation hints, not substitutes for tool instructions.
+# Unknown sources still derive their overview from their own scoped metadata.
+_CAPABILITY_GUIDANCE = {
+    "browser": (
+        "Inspect and interact with web pages: navigation, page snapshots, controls, images and browser state.",
+        "Use for rendered pages, visual inspection or an interactive workflow; discover the specific operation first."),
+    "kanban": (
+        "Organize project work: inspect boards/tasks, create or update tasks, link work, comments, reviews and attachments.",
+        "Use when tracking project progress or coordinating task state; read board/task details before changing them."),
+
+}
+
+
+def _capability_card(label: str, definitions: List[Dict[str, Any]]) -> str:
+    """Four-line, schema-free overview derived from the scoped registry metadata.
+
+    No LLM summaries, filesystem reads or changing runtime counters enter the
+    prefix. Parameter names/types are orientation only; describe retains every
+    description, required field and constraint before execution.
+    """
+    functions = sorted((_fn(td) for td in definitions), key=lambda fn: fn.get("name", ""))
+    names = [fn["name"] for fn in functions]
+    examples = list(dict.fromkeys(
+        _short_desc(fn.get("description", ""), 135) for fn in functions
+        if fn.get("description")))[:3]
+    parameters = {}
+    required = set()
+    for fn in functions:
+        required.update((fn.get("parameters") or {}).get("required") or [])
+        for name, value in sorted(((fn.get("parameters") or {}).get("properties") or {}).items()):
+            kind = value.get("type", "value") if isinstance(value, dict) else "value"
+            parameters.setdefault(name, str(kind))
+    input_names = sorted(parameters, key=lambda name: (name not in required, name))[:8]
+    inputs = ", ".join(f"{name} ({parameters[name]})" for name in input_names)
+    if len(parameters) > 8:
+        inputs += ", …"
+    purpose, selection = _CAPABILITY_GUIDANCE.get(label, (
+        "; ".join(examples),
+        "Use this source for the operations described above; search its name plus your intended action, and combine sources when needed."))
+    return "\n".join([
+        f"{label} — {len(names)} available tools: " + purpose,
+        selection,
+        "Typical inputs: " + (inputs or "see the selected tool") +
+        ". Get full instructions/constraints and response details via tool_describe; never infer arguments.",
+        "Exact names: " + ", ".join(names),
+    ])
+
+
 def build_catalog_listing_with_form(
